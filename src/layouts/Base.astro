---
import '../styles/global.css';
import { getLocaleFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  title?: string;
}

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const { title } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={t('app.tagline')} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Apply a chosen light/dark theme before the first paint (no flash).
      try {
        var saved = JSON.parse(localStorage.getItem('cube-tutor:v1') || '{}');
        var theme = saved.settings && saved.settings.theme;
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch (e) {}
    </script>
    <title>{title ? `${title} · ${t('app.title')}` : t('app.title')}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
