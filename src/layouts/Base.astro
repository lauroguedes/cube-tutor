---
import '../styles/global.css';
import { PROJECT } from '../brand/project';
import { defaultLocale, LOCALES } from '../i18n/ui';
import { alternates, getLocaleFromUrl, LOCALE_KEY, useTranslations } from '../i18n/utils';

interface Props {
  /** Page title; the site name is appended. Omit on the home page. */
  title?: string;
  /** Meta and social description. Defaults to the site tagline. */
  description?: string;
  /** Social image path, relative to the site. */
  image?: string;
  /** Keep this page out of search results (e.g. 404). */
  noindex?: boolean;
  /** Structured data (schema.org) for this page. */
  jsonLd?: Record<string, unknown>;
}

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const { title, description = t('seo.description'), image = LOCALES[locale].ogImage, noindex = false, jsonLd } = Astro.props;

const siteName = t('app.title');
const fullTitle = title ? `${title} · ${siteName}` : `${siteName}: ${t('seo.homeTitle')}`;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;
const meta = LOCALES[locale];
// The same page in every language, for search engines (hreflang) and social cards.
const translations = alternates(Astro.url.pathname).map((a) => ({ ...a, href: new URL(a.path, site).href }));
---

<!doctype html>
<html lang={meta.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {
      !noindex &&
        translations.map((a) => <link rel="alternate" hreflang={LOCALES[a.locale].lang} href={a.href} />)
    }
    {!noindex && <link rel="alternate" hreflang="x-default" href={translations.find((a) => a.locale === defaultLocale)!.href} />}
    <meta name="author" content={PROJECT.author} />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme and icons -->
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#e4e7ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1d22" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('seo.imageAlt')} />
    <meta property="og:locale" content={meta.og} />
    {translations.filter((a) => a.locale !== locale).map((a) => <meta property="og:locale:alternate" content={LOCALES[a.locale].og} />)}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={t('seo.imageAlt')} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script is:inline>
      // Apply a chosen light/dark theme before the first paint (no flash).
      try {
        var saved = JSON.parse(localStorage.getItem('cube-tutor:v1') || '{}');
        var theme = saved.settings && saved.settings.theme;
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch (e) {}
    </script>
    {
      Astro.url.pathname === '/' && (
        <script is:inline define:vars={{ homes: Object.fromEntries(translations.map((a) => [a.locale, a.path])), key: LOCALE_KEY }}>
          // The home page opens in the language picked before or, on a first visit,
          // the browser's preferred one. Links to other pages are left as shared.
          try {
            var chosen = localStorage.getItem(key);
            if (!chosen) {
              var prefs = navigator.languages || [navigator.language];
              for (var i = 0; i < prefs.length && !chosen; i++) {
                var pref = String(prefs[i]).toLowerCase();
                for (var loc in homes) if (pref === loc || pref.split('-')[0] === loc.split('-')[0]) chosen = loc;
              }
            }
            if (chosen && homes[chosen] && homes[chosen] !== location.pathname) location.replace(homes[chosen]);
          } catch (e) {}
        </script>
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
