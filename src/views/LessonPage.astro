---
import Base from '../layouts/Base.astro';
import LessonPlayer from '../components/LessonPlayer.vue';
import { LESSONS, courseText, lessonIndex } from '../course';
import { LOCALES } from '../i18n/ui';
import { getLocaleFromUrl, localePath, useTranslations } from '../i18n/utils';
import { parseScript } from '../tutor/script';

interface Props {
  lessonId: string;
}

const { lessonId } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const text = courseText(locale);
const lesson = LESSONS.find((l) => l.id === lessonId)!;
const info = text.lessons[lessonId]!;
const position = lessonIndex(lessonId) + 1;
const description = t('seo.lessonDescription', { summary: info.summary });
const site = (Astro.site ?? new URL(Astro.url.origin)).href;
const url = (path: string) => new URL(localePath(locale, path), site).href;

// The tutor's words, without cue markers: a transcript for search engines and
// screen readers (the same text appears as captions during the lesson).
const transcript = lesson.steps.flatMap((s) => {
  const st = text.steps[s.id]!;
  return [parseScript(st.say).text, st.done ? parseScript(st.done).text : null].filter(Boolean) as string[];
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LearningResource',
      name: info.title,
      description,
      url: url(`/learn/${lessonId}`),
      learningResourceType: 'Lesson',
      educationalLevel: 'Beginner',
      isAccessibleForFree: true,
      inLanguage: LOCALES[locale].lang,
      position,
      isPartOf: { '@type': 'Course', name: t('seo.courseName'), url: url('/') },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t('app.title'), item: url('/') },
        { '@type': 'ListItem', position: 2, name: t('learn.title'), item: url('/learn') },
        { '@type': 'ListItem', position: 3, name: info.title, item: url(`/learn/${lessonId}`) },
      ],
    },
  ],
};
---

<Base title={info.title} description={description} jsonLd={jsonLd}>
  <LessonPlayer client:only="vue" locale={locale} lessonId={lessonId} />
  <article class="visually-hidden" aria-label={`${info.title}: ${t('lesson.transcript')}`}>
    <h1>{info.title}</h1>
    <p>{info.summary}</p>
    {transcript.map((line) => <p>{line}</p>)}
  </article>
</Base>
