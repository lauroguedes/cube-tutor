---
import Base from '../layouts/Base.astro';
import BrandMark from '../components/BrandMark.vue';
import { getLocaleFromUrl, localePath, useTranslations } from '../i18n/utils';

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
---

<Base title={t('notFound.title')} noindex>
  <main class="wrap fx-mount">
    <BrandMark href={localePath(locale, '/')} label={t('app.title')} />
    <p class="code">404</p>
    <h1>{t('notFound.title')}</h1>
    <p class="text">{t('notFound.text')}</p>
    <a class="primary" href={localePath(locale, '/')}>{t('notFound.home')}</a>
  </main>
</Base>

<style>
  .wrap {
    min-height: 100dvh;
    max-width: 36rem;
    margin: 0 auto;
    padding: var(--gutter);
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1rem;
  }
  .code {
    margin: 2rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(5rem, 3rem + 10vw, 9rem);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.05em;
    background: linear-gradient(transparent 62%, var(--highlight) 62%, var(--highlight) 90%, transparent 90%);
  }
  h1 {
    font-size: var(--step-2);
  }
  .text {
    margin: 0 0 0.5rem;
    color: var(--ink-soft);
  }
</style>
