// Cloudflare Workers configuration: the built static site served as assets.
// No server code and no adapter: Astro's static output in ./dist is the whole app.
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cube-tutor",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Unknown URLs get the site's own 404 page (with a real 404 status).
    "not_found_handling": "404-page",
    // Pages live at /learn/ etc.; /learn redirects to /learn/.
    "html_handling": "auto-trailing-slash"
  },
  // Served on a subdomain of lauroguedes.dev (its DNS is on Cloudflare);
  // deploying creates the DNS record and certificate automatically.
  "routes": [{ "pattern": "cubetutor.lauroguedes.dev", "custom_domain": true }],
  "observability": { "enabled": true }
}
